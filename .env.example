# CareerBridge AI - contoh konfigurasi lingkungan.
# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit .env dan JANGAN isi nilai asli di file ini.
# Jalankan Langflow dengan:  uv run langflow run --env-file .env

# ---------------------------------------------------------------
# Level 1, 2, 3 - IBM watsonx.ai (model IBM Granite)
# ---------------------------------------------------------------
# API key IBM Cloud untuk watsonx.ai. Setelah flow di-import, pada field "API Key"
# node Language Model klik ikon globe lalu pilih variabel ini.
WATSONX_API_KEY=

# Project ID watsonx.ai. Diisi langsung pada field "watsonx Project ID" di node
# (field ini tersembunyi; buka pengaturan lanjutan node). Dicatat di sini sebagai referensi.
WATSONX_PROJECT_ID=

# Endpoint watsonx.ai. Bawaan komponen adalah https://us-south.ml.cloud.ibm.com;
# ganti sesuai region akunmu. Diisi pada field "watsonx API Endpoint" di node.
# WATSONX_URL=

# Nama model Granite dipilih lewat antarmuka Langflow, tidak diisi di sini.

# ---------------------------------------------------------------
# Langflow - ambil variabel di atas sebagai Global Variable (tipe Credential)
# ---------------------------------------------------------------
LANGFLOW_VARIABLES_TO_GET_FROM_ENVIRONMENT=WATSONX_API_KEY

# ---------------------------------------------------------------
# LEVEL 2 - Astra DB (aktifkan saat mengerjakan Data & Personalization)
# ---------------------------------------------------------------
# Nama variabel ini sudah dirujuk oleh node Astra DB pada
# langflow/level-2-data-personalization.json.
# ASTRA_DB_APPLICATION_TOKEN=
# Database, API endpoint, dan collection dipilih pada node Astra DB di Langflow.

# ---------------------------------------------------------------
# LEVEL 3 - Composio (aktifkan saat mengerjakan Action & Automation)
# ---------------------------------------------------------------
# Nama variabel ini sudah dirujuk oleh node Composio Google Calendar pada
# langflow/level-3-action-automation.json.
# COMPOSIO_API_KEY=
# Akun dan aksi kalender dihubungkan lewat antarmuka Langflow.

# Untuk Level 2 dan 3, tambahkan nama variabel yang dipakai ke baris
# LANGFLOW_VARIABLES_TO_GET_FROM_ENVIRONMENT, dipisahkan koma, contoh:
# LANGFLOW_VARIABLES_TO_GET_FROM_ENVIRONMENT=WATSONX_API_KEY,ASTRA_DB_APPLICATION_TOKEN,COMPOSIO_API_KEY
